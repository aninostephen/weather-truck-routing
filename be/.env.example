# Django settings
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HERE API credentials & endpoints
HERE_API_KEY=your_here_api_key_here
HERE_GEOCODE_URL=https://geocode.search.hereapi.com/v1/geocode
HERE_AUTOSUGGEST_URL=https://autosuggest.search.hereapi.com/v1/autosuggest
HERE_ROUTES_URL=https://router.hereapi.com/v8/routes

# OpenWeather API credentials & endpoints
# OPENWEATHER_MODE options:
# - "forecast25" (default): /data/2.5/forecast (3h steps interpolated to 1h)
# - "onecall30": /data/3.0/onecall (native 1h steps for 48h, falls back to forecast25 if unauthorized)
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_MODE=forecast25
OPENWEATHER_FORECAST_25_URL=https://api.openweathermap.org/data/2.5/forecast
OPENWEATHER_ONECALL_30_URL=https://api.openweathermap.org/data/3.0/onecall

